# ============================================================
# INTERVUE - Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ============================================================

# ---- LLM (OpenRouter) --------------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model slug available on OpenRouter. Kept configurable so the
# app never depends on one specific model existing forever.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Used automatically if the primary model fails after retries.
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# ---- Voice (Sarvam AI) --------------------------------------
# Get a key at https://www.sarvam.ai/
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_VOICE=meera
SARVAM_STT_LANGUAGE=en-IN
# If true and Sarvam fails, the app falls back to gTTS/SpeechRecognition
# (still requires outbound internet access at runtime).
ENABLE_VOICE_FALLBACK=true

# ---- Database (Supabase / PostgreSQL) ------------------------
# For local dev you can leave this unset to use a local SQLite file.
# In production, point this at your Supabase Postgres connection string:
# postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./intervue.db

# Only needed if you use Supabase Storage for resume files instead of
# local disk storage. Never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App -----------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Resume upload limits
MAX_RESUME_SIZE_MB=5

# Interview tuning
MIN_QUESTIONS=6
MAX_QUESTIONS=12
