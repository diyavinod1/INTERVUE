# ============================================================
# INTERVUE - Backend Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to version control.
# ============================================================

# ---- LLM (OpenRouter) --------------------------------------
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Recommended conversational models on OpenRouter:
#   meta-llama/llama-3.3-70b-instruct:free (High quality free tier)
#   meta-llama/llama-3.3-70b-instruct (Fast, high-reasoning paid)
#   google/gemini-2.0-flash-001 (Very fast, smart conversational model)
#   mistralai/mistral-small-3 (High quality, low latency)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# ---- Voice (Sarvam AI - Optional) --------------------------
# Get a key at https://www.sarvam.ai/ (leave empty if not using Sarvam)
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_VOICE=meera
SARVAM_STT_LANGUAGE=en-IN
# If true and Sarvam fails or is unconfigured, falls back to browser/gTTS
ENABLE_VOICE_FALLBACK=true

# ---- Database (PostgreSQL / Supabase / SQLite) -------------
# For local dev: leave unset to use local SQLite (sqlite:///./intervue.db).
# For Render / Supabase / PostgreSQL in production:
#   postgresql://user:password@hostname:5432/dbname
# Note: Both postgres:// and postgresql:// formats are supported automatically.
DATABASE_URL=

# Optional Supabase storage (only if storing resume files in Supabase bucket)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App & Networking --------------------------------------
# In production on Render:
# FRONTEND_URL is the deployed frontend URL (e.g. https://intervue-frontend.onrender.com)
# Multiple comma-separated origins are supported.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Resume upload limits
MAX_RESUME_SIZE_MB=5

# Interview tuning
MIN_QUESTIONS=6
MAX_QUESTIONS=12
